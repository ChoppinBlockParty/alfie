# Copy to .env.local, fill in locally, chmod 600 .env.local. Never commit that file.
# Load via deployment/local-env.sh using Bash, never zsh's ambient HOST parameter.
ALFIE_VPS_HOST=your-ssh-alias
ALFIE_PUBLIC_IPV4=192.0.2.10
ALFIE_PUBLIC_IPV6=2001:db8::10
# Private operator reference; does not change the gateway bot's runtime credentials.
TELEGRAM_BOT_USERNAME=
# Numeric owner/chat/topic used for email delivery. The owner ID is also used
# by the approval policy; approval chat/topic are configured separately below.
EMAIL_WATCH_CHAT_ID=
EMAIL_WATCH_THREAD_ID=
ALFIE_OWNER_TELEGRAM_USER_ID=
# Dedicated Telegram approval destination. Requests may originate in any topic
# of this forum, but buttons are sent to and accepted only in this topic.
ALFIE_APPROVAL_CHAT_ID=
ALFIE_APPROVAL_THREAD_ID=
